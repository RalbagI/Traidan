{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_by": {
      "minLength": 1,
      "type": "string"
    },
    "enabled": {
      "const": true
    },
    "expires_at": {
      "description": "UTC date-time no more than 2 hours after executor validation time.",
      "format": "date-time",
      "type": "string"
    },
    "max_notional_usd": {
      "exclusiveMinimum": 0.0,
      "type": "number"
    },
    "symbol": {
      "const": "BTC-USD"
    },
    "venue": {
      "const": "coinbase_fix"
    }
  },
  "required": [
    "enabled",
    "venue",
    "symbol",
    "approved_by",
    "expires_at",
    "max_notional_usd"
  ],
  "type": "object"
}
