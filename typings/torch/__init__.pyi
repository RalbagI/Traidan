float32: dtype
bool: dtype


class Tensor:
    def __add__(self, other: float | Tensor) -> Tensor: ...
    def __radd__(self, other: float | Tensor) -> Tensor: ...
    def __sub__(self, other: float | Tensor) -> Tensor: ...
    def __rsub__(self, other: float | Tensor) -> Tensor: ...
    def __mul__(self, other: float | Tensor) -> Tensor: ...
    def __rmul__(self, other: float | Tensor) -> Tensor: ...
    def __truediv__(self, other: float | Tensor) -> Tensor: ...
    def __rtruediv__(self, other: float | Tensor) -> Tensor: ...
    def __neg__(self) -> Tensor: ...
    def __le__(self, other: float | Tensor) -> Tensor: ...
    def __ge__(self, other: float | Tensor) -> Tensor: ...
    def __setitem__(self, idx: object, value: float | Tensor) -> None: ...
    def exp(self) -> Tensor: ...
    def expand_as(self, other: Tensor) -> Tensor: ...
    def detach(self) -> Tensor: ...
    def clone(self) -> Tensor: ...
    def reshape(self, *shape: int) -> Tensor: ...
    def squeeze(self, dim: int | None = ...) -> Tensor: ...
    def to(
        self,
        *,
        device: device | None = ...,
        dtype: dtype | None = ...,
    ) -> Tensor: ...
    def mean(self, dim: int | None = ...) -> Tensor: ...
    def var(self, dim: int | None = ..., unbiased: builtins.bool = ...) -> Tensor: ...
    def std(self, dim: int | None = ..., unbiased: builtins.bool = ...) -> Tensor: ...
    def pow(self, exponent: float) -> Tensor: ...
    def sum(self, dim: int | None = ..., keepdim: builtins.bool = ...) -> Tensor: ...
    def abs(self) -> Tensor: ...
    def item(self) -> float: ...
    def backward(self) -> None: ...
    def data_ptr(self) -> int: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def dtype(self) -> dtype: ...
    @property
    def device(self) -> device: ...
    def __getitem__(self, idx: object) -> Tensor: ...


class Parameter(Tensor):
    def __init__(self, data: Tensor) -> None: ...


