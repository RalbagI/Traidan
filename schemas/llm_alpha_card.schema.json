{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traidan.local/schemas/llm_alpha_card.schema.json",
  "title": "LLM Alpha Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "symbol",
    "side",
    "horizon_minutes",
    "edge_type",
    "thesis",
    "evidence_refs",
    "confidence",
    "expected_alpha_bps",
    "downside_bps",
    "spread_bps",
    "liquidity_score",
    "invalidation",
    "agent_role"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "symbol": { "type": "string", "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$" },
    "side": { "type": "string", "enum": ["long", "short"] },
    "horizon_minutes": { "type": "integer", "minimum": 1, "maximum": 390 },
    "edge_type": { "type": "string", "minLength": 1, "maxLength": 120 },
    "thesis": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "expected_alpha_bps": { "type": "number", "minimum": -10000, "maximum": 10000 },
    "downside_bps": { "type": "number", "minimum": 0, "maximum": 10000 },
    "spread_bps": { "type": "number", "minimum": 0, "maximum": 10000 },
    "liquidity_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "invalidation": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "agent_role": {
      "type": "string",
      "enum": [
        "catalyst_scout",
        "text_edge_analyst",
        "neglected_small_cap_analyst",
        "macro_fedspeak_analyst",
        "macro_fed_analyst",
        "technical_microstructure_analyst",
        "short_contrarian_analyst",
        "risk_cost_analyst",
        "portfolio_learning_analyst",
        "arbiter"
      ]
    }
  }
}
