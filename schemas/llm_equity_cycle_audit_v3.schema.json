{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traidan.local/schemas/llm_equity_cycle_audit_v3.schema.json",
  "title": "LLM Equity Cycle Audit V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cycle_kind", "status", "cycle_id", "created_at",
    "target_release_at", "market_session", "as_of", "symbols_sample", "context",
    "decision", "attempts", "costs", "rust_response", "artifact_refs",
    "strategy_epoch_id", "strategy_fingerprint", "risk_mode", "forecast",
    "source_health_reasons", "cost_basis", "imputed_api_cost_usd",
    "forced_trade_status"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "strategy_epoch_id": { "type": "string", "pattern": "^epoch-[a-f0-9]{16}$" },
    "strategy_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "risk_mode": { "type": "string", "enum": ["bounded", "llm_discretion", "forced_aggressive", "profit_driven", "fully_invested"] },
    "forecast": {
      "type": "array", "maxItems": 9,
      "items": { "$ref": "llm_trading_decision.schema.json#/properties/commands/items/properties/forecast" }
    },
    "source_health_reasons": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "cost_basis": {
      "type": "string",
      "enum": ["subscription_zero", "configured_api", "preflight_estimate", "zero_llm_skip"]
    },
    "imputed_api_cost_usd": { "type": "number", "minimum": 0 },
    "forced_trade_status": {
      "type": "string", "enum": ["not_applicable", "recovering", "accepted", "blocked"]
    },
    "accepted_trades": { "type": "array", "maxItems": 80, "items": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/$defs/accepted_trade" } },
    "alpha_card_count": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/alpha_card_count" },
    "artifact_refs": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/artifact_refs" },
    "as_of": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/as_of" },
    "attempts": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/attempts" },
    "consensus_score": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/consensus_score" },
    "context": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/context" },
    "costs": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/costs" },
    "created_at": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/created_at" },
    "cycle_id": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/cycle_id" },
    "cycle_kind": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/cycle_kind" },
    "dashboard_summary_thesis": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/dashboard_summary_thesis" },
    "decision": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/decision" },
    "discovery_lane_counts": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/discovery_lane_counts" },
    "edge_gate_status": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/edge_gate_status" },
    "event_candidate_count": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/event_candidate_count" },
    "event_command_count": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/event_command_count" },
    "execution_attempts": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/execution_attempts" },
    "exploration_candidate_count": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/exploration_candidate_count" },
    "exploration_mode": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/exploration_mode" },
    "gross_exposure_pct": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/gross_exposure_pct" },
    "net_exposure_abs_pct": { "type": "number", "minimum": 0 },
    "short_gross_exposure_pct": { "type": "number", "minimum": 0 },
    "daily_turnover_pct": { "type": "number", "minimum": 0 },
    "daily_loss_pct": { "type": "number", "minimum": 0 },
    "max_drawdown_pct": { "type": "number", "minimum": 0 },
    "llm_invoked": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/llm_invoked" },
    "mandatory_accepted_notional_usd": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/mandatory_accepted_notional_usd" },
    "mandatory_accepted_total_notional_usd": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/mandatory_accepted_total_notional_usd" },
    "mandatory_remaining_notional_usd": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/mandatory_remaining_notional_usd" },
    "mandatory_required_total_notional_usd": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/mandatory_required_total_notional_usd" },
    "mandatory_trade_required": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/mandatory_trade_required" },
    "mandatory_trade_status": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/mandatory_trade_status" },
    "market_session": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/market_session" },
    "net_alpha_usd": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/net_alpha_usd" },
    "no_trade_reason": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/no_trade_reason" },
    "parent_cycle_id": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/parent_cycle_id" },
    "portfolio_nav_usd": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/portfolio_nav_usd" },
    "public_event_card_count": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/public_event_card_count" },
    "public_event_impacted_symbol_count": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/public_event_impacted_symbol_count" },
    "public_event_max_score": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/public_event_max_score" },
    "recovery_attempt_count": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/recovery_attempt_count" },
    "review_attestation": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/review_attestation" },
    "risk_budget_status": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/risk_budget_status" },
    "rust_rejection_reasons": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/rust_rejection_reasons" },
    "rust_response": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/rust_response" },
    "selected_strategy_book": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/selected_strategy_book" },
    "speculative_candidate_count": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/speculative_candidate_count" },
    "speculative_command_count": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/speculative_command_count" },
    "speculative_command_notional_usd": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/speculative_command_notional_usd" },
    "status": {
      "type": "string",
      "enum": ["posted", "held", "prepared", "blocked", "failed", "ready_existing",
        "already_handled", "skipped_no_edge", "research_only", "skipped_stale"]
    },
    "swarm_agent_count": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/swarm_agent_count" },
    "symbols_sample": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/symbols_sample" },
    "target_release_at": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/target_release_at" },
    "total_pnl_usd": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/total_pnl_usd" },
    "validation_repair_count": { "$ref": "llm_equity_cycle_audit_v2.schema.json#/properties/validation_repair_count" }
  }
}
