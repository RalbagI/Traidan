{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traidan.local/schemas/llm_research_forecast_outcome.schema.json",
  "title": "LLM Equity Research ForecastOutcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "arm", "cycle_id", "outcome_id", "symbol",
    "side", "horizon", "entry_price", "matures_at", "outcome_return_bps",
    "exit_price", "exit_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string" },
    "arm": { "type": "string" },
    "cycle_id": { "type": "string" },
    "outcome_id": { "type": "string" },
    "symbol": { "type": "string" },
    "side": { "type": "string", "enum": ["long", "short"] },
    "direction": { "type": "string", "enum": ["long", "short", "avoid"] },
    "horizon": { "type": "string", "enum": ["30m", "60m", "close", "1d", "5d"] },
    "cycle_kind": { "type": "string" },
    "entry_price": { "type": "number", "exclusiveMinimum": 0 },
    "matures_at": { "type": "string", "format": "date-time" },
    "strategy_book": { "type": "string" },
    "discovery_lane": { "type": "string" },
    "role": { "type": "string" },
    "probability_positive": { "type": "number", "minimum": 0, "maximum": 1 },
    "expected_alpha_bps": { "type": "number" },
    "return_p10_bps": { "type": ["number", "null"] },
    "return_p50_bps": { "type": ["number", "null"] },
    "return_p90_bps": { "type": ["number", "null"] },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "diagnostic_only": { "type": "boolean" },
    "rust_result_object": { "type": "string" },
    "benchmark_symbol": { "type": "string" },
    "benchmark_entry_price": { "type": ["number", "null"] },
    "spread_cost_bps": { "type": "number", "minimum": 0 },
    "impact_cost_bps": { "type": "number", "minimum": 0 },
    "commission_cost_bps": { "type": "number", "minimum": 0 },
    "financing_cost_bps": { "type": "number", "minimum": 0 },
    "borrow_cost_bps": { "type": "number", "minimum": 0 },
    "regime": { "type": "string" },
    "outcome_return_bps": { "type": "number" },
    "benchmark_return_bps": { "type": "number" },
    "outcome_net_alpha_bps": { "type": "number" },
    "exit_price": { "type": "number", "exclusiveMinimum": 0 },
    "exit_at": { "type": "string", "format": "date-time" }
  }
}
