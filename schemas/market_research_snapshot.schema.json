{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traidan.local/schemas/market_research_snapshot.schema.json",
  "title": "LLM equity dry-run market research snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "as_of",
    "market_session",
    "symbols",
    "latest_bars",
    "latest_quotes",
    "market_calendar_state",
    "trend_summaries",
    "source_freshness",
    "macro_news_summaries",
    "unavailable_data_flags"
  ],
  "properties": {
    "snapshot_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "as_of": { "type": "string", "format": "date-time" },
    "market_session": { "type": "string", "enum": ["premarket", "rth", "after_hours", "closed"] },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$" },
      "uniqueItems": true
    },
    "latest_bars": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "open", "high", "low", "close", "volume", "source"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "open": { "type": "number" },
          "high": { "type": "number" },
          "low": { "type": "number" },
          "close": { "type": "number" },
          "volume": { "type": "number", "minimum": 0 },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "latest_quotes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "bid", "ask", "source"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "bid": { "type": "number", "minimum": 0 },
          "ask": { "type": "number", "minimum": 0 },
          "source": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "source": { "not": { "pattern": "unavailable" } } },
              "required": ["source"]
            },
            "then": {
              "properties": {
                "bid": { "exclusiveMinimum": 0 },
                "ask": { "exclusiveMinimum": 0 }
              }
            }
          }
        ]
      }
    },
    "session_bars": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/bar" }
    },
    "previous_daily_bars": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/bar" }
    },
    "asset_metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tradable", "shortable", "fractionable"],
        "properties": {
          "tradable": { "type": "boolean" },
          "shortable": { "type": "boolean" },
          "fractionable": { "type": "boolean" },
          "investment_kind": { "type": "string", "enum": ["equity_stock", "equity_etf", "excluded"] }
        }
      }
    },
    "discovery_health": { "type": "object" },
    "market_calendar_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "retrieved_at", "is_open", "next_open", "next_close", "freshness"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 200 },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "is_open": { "type": "boolean" },
        "next_open": { "type": "string", "maxLength": 120 },
        "next_close": { "type": "string", "maxLength": 120 },
        "freshness": { "type": "string", "enum": ["fresh", "stale", "unavailable"] }
      }
    },
    "trend_summaries": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 1000 } },
    "source_freshness": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "freshness"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 200 },
          "freshness": { "type": "string", "enum": ["fresh", "stale", "unavailable"] }
        }
      },
      "allOf": [
        { "contains": { "properties": { "source": { "const": "alpaca_market_data" } }, "required": ["source", "freshness"] } },
        { "contains": { "properties": { "source": { "const": "alpaca_market_clock" } }, "required": ["source", "freshness"] } },
        { "contains": { "properties": { "source": { "const": "macro_calendar" } }, "required": ["source", "freshness"] } },
        { "contains": { "properties": { "source": { "const": "news_summary" } }, "required": ["source", "freshness"] } }
      ]
    },
    "macro_news_summaries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "url", "retrieved_at", "summary", "freshness"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 200 },
          "url": { "type": "string", "maxLength": 500 },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "published_at": { "type": "string", "format": "date-time" },
          "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "freshness": { "type": "string", "enum": ["fresh", "stale", "unavailable"] },
          "source_records": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "published_at", "content_hash", "summary"],
              "properties": {
                "url": { "type": "string", "maxLength": 500 },
                "published_at": { "type": "string", "format": "date-time" },
                "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
              }
            }
          }
        }
      },
      "allOf": [
        { "contains": { "properties": { "source": { "const": "macro_calendar" } }, "required": ["source", "url", "retrieved_at", "summary", "freshness"] } },
        { "contains": { "properties": { "source": { "const": "news_summary" } }, "required": ["source", "url", "retrieved_at", "summary", "freshness"] } }
      ]
    },
    "unavailable_data_flags": { "type": "array", "items": { "type": "string", "maxLength": 120 } }
  },
  "$defs": {
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "open", "high", "low", "close", "volume", "source"],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "open": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "close": { "type": "number" },
        "volume": { "type": "number", "minimum": 0 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
