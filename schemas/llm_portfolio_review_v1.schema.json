{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traidan.local/schemas/llm_portfolio_review_v1.schema.json",
  "title": "Fully invested model portfolio",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "holdings",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "holdings": {
      "type": "array",
      "minItems": 20,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "weight_bps",
          "thesis",
          "invalidation",
          "horizon",
          "expected_excess_return_bps"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$"
          },
          "weight_bps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "thesis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "invalidation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "horizon": {
            "type": "string",
            "enum": [
              "30m",
              "60m",
              "close",
              "1d",
              "5d"
            ]
          },
          "expected_excess_return_bps": {
            "type": "number",
            "minimum": -5000,
            "maximum": 5000
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
