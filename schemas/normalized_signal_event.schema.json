{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traidan.local/schemas/normalized_signal_event.schema.json",
  "title": "Future multi-asset normalized signal event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signal_id",
    "source_id",
    "observation_id",
    "as_of",
    "event_time",
    "asset_refs",
    "entity_refs",
    "region_refs",
    "signal_family",
    "horizon",
    "direction_hint",
    "confidence",
    "magnitude",
    "freshness",
    "summary",
    "evidence_refs",
    "quality_flags"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "signal_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,80}$" },
    "observation_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "as_of": { "type": "string", "format": "date-time" },
    "event_time": { "type": "string", "format": "date-time" },
    "asset_refs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "entity_refs": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "region_refs": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "signal_family": { "type": "string", "minLength": 1, "maxLength": 120 },
    "horizon": { "type": "string", "enum": ["intraday", "short", "medium", "long"] },
    "direction_hint": { "type": "string", "enum": ["bullish", "bearish", "neutral", "risk_off", "risk_on"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "magnitude": { "type": "number", "minimum": -1, "maximum": 1 },
    "freshness": { "type": "string", "enum": ["fresh", "stale", "unavailable"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "quality_flags": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }
  }
}
