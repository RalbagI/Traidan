{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traidan.local/schemas/llm_research_specialist_result.schema.json",
  "title": "LLM Equity Research Specialist Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "abstain", "cards"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "abstain": { "type": "boolean" },
    "cards": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_id",
          "symbol",
          "side",
          "horizon",
          "strategy_book",
          "discovery_lane",
          "thesis",
          "evidence_refs",
          "confidence",
          "expected_alpha_bps",
          "downside_bps",
          "probability_positive",
          "return_p10_bps",
          "return_p50_bps",
          "return_p90_bps"
        ],
        "properties": {
          "card_id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "symbol": { "type": "string", "pattern": "^(?:[A-Z][A-Z0-9.\\-]{0,9}|SYM[0-9]{3,6})$" },
          "side": { "type": "string", "enum": ["long", "short"] },
          "horizon": { "type": "string", "enum": ["30m", "60m", "close", "1d", "5d"] },
          "strategy_book": { "type": "string", "minLength": 1, "maxLength": 80 },
          "discovery_lane": { "type": "string", "minLength": 1, "maxLength": 80 },
          "thesis": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "expected_alpha_bps": { "type": "number", "minimum": -10000, "maximum": 10000 },
          "downside_bps": { "type": "number", "minimum": 0, "maximum": 10000 },
          "probability_positive": { "type": "number", "minimum": 0, "maximum": 1 },
          "return_p10_bps": { "type": "number", "minimum": -10000, "maximum": 10000 },
          "return_p50_bps": { "type": "number", "minimum": -10000, "maximum": 10000 },
          "return_p90_bps": { "type": "number", "minimum": -10000, "maximum": 10000 }
        }
      }
    }
  }
}
